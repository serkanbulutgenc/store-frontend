    "/api/store/categories": {
      "get": {
        "description": "The two-level category tree for the header menu and the homepage.",
        "operationId": "catalog_list_categories",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CategoryNodeOut"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List Categories",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/store/csrf": {
      "get": {
        "description": "CSRF token for guest endpoints. The cookie is HttpOnly, so JS cannot read it.",
        "operationId": "auth_get_csrf",
        "parameters": [],
