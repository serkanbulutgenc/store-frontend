            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "title": "Size",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "brand",
            "required": false,
            "schema": {
              "items": {
                "type": "integer"
              },
              "title": "Brand",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "price_min",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Price Min"
            }
          },
          {
            "in": "query",
            "name": "price_max",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Price Max"
            }
          },
          {
            "in": "query",
            "name": "in_stock",
            "required": false,
            "schema": {
              "default": true,
              "title": "In Stock",
              "type": "boolean"
