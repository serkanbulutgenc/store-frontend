                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Category slug, children included.",
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "colour",
