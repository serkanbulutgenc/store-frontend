      "get": {
        "description": "Product cards, 24 per page, with facet counts that respect the other filters.",
        "operationId": "catalog_list_products",
        "parameters": [
          {
            "description": "Category slug, children included.",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Category slug, children included.",
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "colour",
            "required": false,
            "schema": {
              "items": {
                "type": "integer"
              },
              "title": "Colour",
              "type": "array"
            }
          },
          {
            "in": "query",
