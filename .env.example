# Internal URL of the Django API (private network, never exposed to the browser)
API_INTERNAL_URL=http://api:8000
# Name of the HttpOnly session cookie that holds the allauth token
SESSION_COOKIE_NAME=store_session
# Django CSRF cookie name (the proxy echoes it as X-CSRFToken); __Secure-csrftoken in production
CSRF_COOKIE_NAME=csrftoken
